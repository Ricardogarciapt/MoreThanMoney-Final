# Copiar para .env (NÃO commitar). Secrets reais só no VPS.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
GMI_SESSION_STRING=          # sessão de utilizador (Ricardo) que é membro da GMI
MTM_BOT_TOKEN=              # bot MoreThanMoney (admin da Premium)
GMI_SOURCE_ID=-1003812659078   # Global Market intelligence
GMI_DEST_CHAT=-1002424441843   # MTM Premium
GMI_DRY_RUN=1              # 1 = só imprime; 0 = publica a sério
GMI_STATE_FILE=/opt/gmi-relay/gmi_relay_state.json
GMI_POLL_SEC=40           # loop de polling
GMI_LOOKBACK_H=1          # 1ª passagem: horas para trás
