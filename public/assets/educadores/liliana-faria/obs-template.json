  "streaming": {
    "service": "custom_rtmps",
    "server": "rtmps://live.supabase.io:443/app",
    "key_placeholder": "STREAM_KEY_FROM_LMS_EDUCATORS",
    "bitrate": {
      "video_bitrate": 2500,
      "audio_bitrate": 128
    },
    "encoding": {
      "encoder": "x264",
      "preset": "veryfast",
      "profile": "main",
      "keyframe_interval": 2
    },
    "audio": {
      "sample_rate": 44100,
      "channels": 2
    }
  },
  "hotkeys": {
    "start_stream": "Alt+F9",
    "stop_stream": "Alt+F10",
    "switch_scene_workshop": "Alt+1",
    "switch_scene_screen": "Alt+2",
    "switch_scene_break": "Alt+3",
    "toggle_chat": "Alt+C"
  },
  "tips_for_setup": [
    "Substituir STREAM_KEY_FROM_LMS_EDUCATORS pela chave fixa no campo stream_key_fixed da BD",
    "Preparar slides e conteúdo visual para compartilhamento de tela",
    "Testar câmera, áudio e monitoramento de chat antes de iniciar",
    "Atualizar estatísticas de social media antes de cada stream",
    "Usar tela de intervalo entre segmentos para criar profissionalismo"
