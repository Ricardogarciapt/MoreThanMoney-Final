  "streaming": {
    "service": "custom_rtmps",
    "server": "rtmps://live.supabase.io:443/app",
    "key_placeholder": "STREAM_KEY_FROM_LMS_EDUCATORS",
    "bitrate": {
      "video_bitrate": 2500,
      "audio_bitrate": 128
    },
    "encoding": {
      "encoder": "x264",
      "preset": "veryfast",
      "profile": "main",
      "keyframe_interval": 2
    },
    "audio": {
      "sample_rate": 44100,
      "channels": 2
    }
  },
  "hotkeys": {
    "start_stream": "Alt+F9",
    "stop_stream": "Alt+F10",
    "switch_scene_1": "Alt+1",
    "switch_scene_2": "Alt+2",
    "toggle_chat": "Alt+C"
  },
  "tips_for_setup": [
    "Substituir STREAM_KEY_FROM_LMS_EDUCATORS pela chave fixa no campo stream_key_fixed da BD",
    "Ajustar resolução da câmera conforme disponibilidade do hardware",
    "Testar áudio e vídeo antes de iniciar live",
    "Verificar iluminação frontal para melhor qualidade de câmera",
    "Manter chat visível durante interações com audiência"
  ]
