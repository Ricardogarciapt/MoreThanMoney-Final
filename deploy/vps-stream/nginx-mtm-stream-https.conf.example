# Exemplo completo: HTTP (ACME + redirect) + HTTPS com HLS para o site MTM.
# Ajusta server_name e caminhos Let's Encrypt se o domínio for outro.
#
# Uso sugerido na VPS:
#   sudo cp nginx-mtm-stream-https.conf.example /etc/nginx/sites-available/mtm-stream
#   sudo ln -sf /etc/nginx/sites-available/mtm-stream /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d stream.morethanmoney.pt   # se ainda não tens certificado
#
# SRS deve servir HLS em http://127.0.0.1:8080/live/ (app "live").

server {
    listen 80;
    listen [::]:80;
    server_name stream.morethanmoney.pt;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }


    # Preços do MTM Funded (funded-motor, ws-precos.ts). O prefixo serve os dois:
    #   wss://…/precos       → WS dos browsers (WebTrader)
    #   https://…/precos/tick → tick síncrono para a abertura de ordens (x-caption-secret)
    # A porta é a de `WS_PRECOS_PORTA` no /etc/mtm-funded-motor.env: na VPS é 8788 (a 8787 está
    # ocupada pela ponte do conector MT5). Trocá-la aqui sem trocar lá parte as duas coisas.
    location /precos {
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location /hls/ {
        proxy_pass http://127.0.0.1:8080/live/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        add_header Access-Control-Allow-Origin * always;
    }

    location /live/ {
        proxy_pass http://127.0.0.1:8080/live/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        add_header Access-Control-Allow-Origin * always;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name stream.morethanmoney.pt;

    ssl_certificate /etc/letsencrypt/live/stream.morethanmoney.pt/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stream.morethanmoney.pt/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;


    # Preços do MTM Funded (funded-motor, ws-precos.ts). O prefixo serve os dois:
    #   wss://…/precos       → WS dos browsers (WebTrader)
    #   https://…/precos/tick → tick síncrono para a abertura de ordens (x-caption-secret)
    # A porta é a de `WS_PRECOS_PORTA` no /etc/mtm-funded-motor.env: na VPS é 8788 (a 8787 está
    # ocupada pela ponte do conector MT5). Trocá-la aqui sem trocar lá parte as duas coisas.
    location /precos {
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location /hls/ {
        proxy_pass http://127.0.0.1:8080/live/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        add_header Access-Control-Allow-Origin * always;
    }

    location /live/ {
        proxy_pass http://127.0.0.1:8080/live/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        add_header Access-Control-Allow-Origin * always;
    }

    location / {
        return 200 'MTM stream OK\n';
        add_header Content-Type text/plain;
    }
}
