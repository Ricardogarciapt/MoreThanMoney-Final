# Copiar para /opt/mtm-stream/dvr-worker/mtm-dvr.env
MTM_API_BASE=https://www.morethanmoney.pt
# MESMO segredo do worker de legendas (partilha a confiança do VPS)
LMS_CAPTION_WORKER_SECRET=__cola_o_mesmo_secret__
DVR_DIR=/mnt/dvr
DVR_PUBLIC_BASE=https://stream.morethanmoney.pt/dvr
POLL_SECONDS=20

# ── Connector YouTube (opcional) ────────────────────────────────────────────
# Só ativa o upload não-listado → playlist quando as 3 variáveis existem.
# Requer `npm i` nesta pasta (instala googleapis). Cria as credenciais em
# console.cloud.google.com (OAuth Client) + obtém um refresh token com o scope
# https://www.googleapis.com/auth/youtube.force-ssl (permite upload de vídeo,
# criar playlists E enviar legendas/CC) via developers.google.com/oauthplayground.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
