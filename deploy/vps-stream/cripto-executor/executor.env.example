# /etc/mtm-cripto/executor.env  (sudo install -m 600 -o root -g root)
# Supabase (a mesma do mtm-vigias)
NEXT_PUBLIC_SUPABASE_URL=https://iwscxotvmtkphajmasof.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# Cofre da carteira Solana (gerada aqui no 1.º arranque). Frase longa, guardada TAMBEM no gestor de palavras-passe.
CRIPTO_COFRE=/var/lib/mtm-cripto/solana.json
CRIPTO_COFRE_FRASE=...
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Conta Bybit do agente. Por omissao uma subconta propria. Permissoes: Contracts Orders/Positions; Withdraw so se CRIPTO_VARRER_BYBIT=1. Chave presa ao IP da VPS.
BYBIT_AGENTE_API_KEY=
BYBIT_AGENTE_API_SECRET=

# 1 = a chave acima e a da MESTRE do Copy Trading (escolha do Ricardo, 28/10). OS SEGUIDORES COPIAM AS TRADES DO AGENTE.
# Neste modo: nao entra em pares onde a mestre ja tem posicao, fecha so a quantidade dele, mede-se pelo
# CRIPTO_CAPITAL_BYBIT_USD (nunca pelo saldo da mestre) e nunca levanta dinheiro da Bybit (o lucro fica na mestre).
# Gerar uma chave NOVA na mestre so com Contracts Orders/Positions, SEM Withdraw, presa ao IP da VPS.
CRIPTO_BYBIT_MESTRE=0
CRIPTO_CAPITAL_BYBIT_USD=0

# Segunda chave do modo real (a primeira e modo='real' no dashboard). 0 = so publica endereco e saldos.
CRIPTO_REAL=0

# Tectos (USD). Comecar pequeno; so o dono os sobe, aqui.
# CAPITAL_BASE = capital Solana + CRIPTO_CAPITAL_BYBIT_USD (o que conta para o lucro da sessao).
CRIPTO_CAPITAL_BASE_USD=0
CRIPTO_ORDEM_MAX_USD=25
CRIPTO_EXPOSICAO_MAX_USD=100
CRIPTO_PERDA_DIA_MAX_USD=10
CRIPTO_ALAVANCAGEM_MAX=3
CRIPTO_VARREDURA_MAX_USD=500

# Para onde vao os lucros no fim de cada sessao (endereco Solana do Ricardo). Unico destino possivel.
CRIPTO_DESTINO_LUCROS=
CRIPTO_VARRER_BYBIT=0
