# ──────────────────────────────────────────────────────────────────────────
# Copygram Engine — variáveis de ambiente
# NUNCA commitar o ficheiro .env real (apenas este .env.example).
# Copia para .env e preenche localmente / no painel da plataforma de deploy.
# ──────────────────────────────────────────────────────────────────────────

# Telegram — token do bot @MoreThanMoney_aibot (o mesmo já usado no chat da app-mobile)
# Obtém/gere em: https://t.me/BotFather → /mybots → o teu bot → API Token
# IMPORTANTE: se este token alguma vez for partilhado em texto simples (chat, email,
# print), gera um novo em BotFather (/revoke) e atualiza aqui.
TELEGRAM_BOT_TOKEN=

# Supabase — usar a service_role key (bypassa RLS) para escrever em
# mtmcopy_connections / mtmcopy_signal_log. Mesma key usada no site (.env Vercel).
SUPABASE_URL=https://iwscxotvmtkphajmasof.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# MetaApi (https://metaapi.cloud) — cloud bridge para contas MT5, sem precisar de
# VPS Windows. Cria conta gratuita, gera um token de API em Dashboard → API Tokens.
METAAPI_TOKEN=

# Intervalo (ms) entre verificações de novas ligações activas na base de dados
POLL_INTERVAL_MS=30000

# Ambiente
NODE_ENV=production
