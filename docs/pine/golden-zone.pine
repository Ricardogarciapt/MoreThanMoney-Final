//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// GOLDEN ZONE by MTM — scalping de ouro em 5 minutos: níveis psicológicos, zona de ação e plano
//
// PRINCÍPIOS (código próprio da casa):
//  1. Níveis psicológicos: linhas pretas de 5 em 5 $ no ouro (4060, 4065, 4070 …), as únicas linhas fixas
//     do gráfico. Passo automático por mercado, ou fixo no input. Mostram-se N linhas à volta do preço.
//  2. Zona: caixa amarela de 1 $ centrada no nível (4069,50 – 4070,50). A ZONA DE AÇÃO é a aresta
//     do lado do preço (compra: 4070,50 · venda: 4069,50); a outra aresta é a ponta da zona.
//  3. Visto ✓: quando uma vela fecha para lá da zona de ação, a favor da tendência (EMA 50 vs 200),
//     o scanner confirma a tendência: desenha o visto amarelo sobre a vela e a caixa da zona.
//     Ainda não há plano. Cada visto novo apaga o anterior.
//  4. Recuo: quando o preço volta à zona de ação, o scanner dá os parâmetros da posição —
//     Invalidation zone a 1,5 $ (150 pontos) da zona, Exit 1 a +1,5 $ e Exit 2 a +3 $:
//     compra em 4070,50 → invalidação 4069,00 · Exit 1 4072,00 · Exit 2 4073,50.
//  5. Bandeira branca: aparece quando o preço toca o Exit 1 (ou a invalidação). O Exit 2 ou a
//     invalidação fecham o plano; o visto seguinte limpa o gráfico.
//  6. Tabela de estatísticas (desligada por omissão): sinais, planos, Exit 1, Exit 2, invalidações.
//
// ALERTAS / WEBHOOK MTM: Adicionar alerta → condição «Any alert() function call»,
// «Once Per Bar Close», Webhook URL:
//   https://www.morethanmoney.pt/api/webhooks/tradingview?strategy=goldenzone&secret=<secret>
// Eventos JSON: signal (visto), plan (níveis), exit1, exit2, invalidation. Também há
// «Golden Zone Compra» / «Golden Zone Venda» / «Golden Zone Plano» para alertas simples.
// Conteúdo educativo, não constitui consultoria financeira.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Golden Zone by MTM", shorttitle="Golden Zone by MTM", overlay=true, max_lines_count=100, max_labels_count=100, max_boxes_count=50)

// ════════════════════════════════════════════════════════════════
// INPUTS (a mesma disposição do scanner de referência)
// ════════════════════════════════════════════════════════════════
gPsy       = "PSYCHOLOGICAL LEVELS"
showPsy    = input.bool(true,  "Show psychological lines", group=gPsy, tooltip="As únicas linhas fixas do gráfico: uma em cada nível de 5 $ do ouro, a preto.")
psyCount   = input.int(10, "Psychological line count", minval=2, maxval=40, group=gPsy, tooltip="Número de níveis à volta do preço (metade acima, metade abaixo).")
psyCol     = input.color(#000000, "Psychological line color", group=gPsy)

gZone      = "ZONE"
showZones  = input.bool(true, "Show zones", inline="z", group=gZone)
zoneBorder = input.color(color.new(#C9B400, 20), "", inline="z", group=gZone)
zoneFill   = input.color(color.new(#FFEB3B, 82), "", inline="z", group=gZone)

gTable     = "TABLE"
showTable  = input.bool(false, "Show stats table", inline="t", group=gTable)
tblBg      = input.color(#FFF176, "", inline="t", group=gTable)
tblTxt     = input.color(#000000, "", inline="t", group=gTable)
tblPos     = input.string("Top Right", "Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=gTable)
tblSize    = input.string("Normal", "Size", options=["Tiny", "Small", "Normal", "Large"], group=gTable)

gDisp      = "DISPLAY"
colZone    = input.color(#787B86, "Zone of action", group=gDisp)
colExit1   = input.color(#4CAF50, "Exit 1", group=gDisp)
colExit2   = input.color(#4CAF50, "Exit 2", group=gDisp)
colInval   = input.color(#E57373, "Invalidation zone", group=gDisp)
offset     = input.int(20, "Offset", minval=1, maxval=200, group=gDisp, tooltip="Velas para a direita das linhas do plano e validade da zona à espera do recuo. As cores e o offset deste grupo são só da posição activa.")

gMtm       = "MTM"
stepIn     = input.float(0.0, "Psychological step (0 = auto)", minval=0.0, step=0.5, group=gMtm, tooltip="Distância entre níveis. 0 = automático: 5 $ no ouro; noutros mercados, um passo proporcional ao preço.")
riskMult   = input.float(3.0, "Stop distance (× half zone)", minval=1.0, step=0.5, group=gMtm, tooltip="Com a zona de 1 $ (meia zona 0,5 $), 3 × 0,5 = 1,5 $ = 150 pontos: invalidação a −1,5 $, Exit 1 a +1,5 $, Exit 2 a +3 $.")
useTrend   = input.bool(true, "Trend filter (EMA 50 / 200)", group=gMtm, tooltip="Compras só com a EMA 50 acima da 200; vendas só com a 50 abaixo da 200. As médias não se desenham: no gráfico só há as linhas de 5 $ e a posição activa.")
lblLang    = input.string("EN", "Labels language", options=["EN", "PT"], group=gMtm, tooltip="EN: Zone of action / Exit 1 / Exit 2 / Invalidation zone · PT: Zona de ação / Saída 1 / Saída 2 / Invalidação.")
chave      = input.string("GOLDENZONE", "strategy (chave no webhook)", group=gMtm)

// ════════════════════════════════════════════════════════════════
// PARÂMETROS INTERNOS
// ════════════════════════════════════════════════════════════════
const int   BOX_W   = 6            // largura da caixa da zona (velas)
const color C_CHECK = #F5D90A      // visto amarelo
const color C_FLAG  = #FFFFFF      // bandeira branca

// passo automático: 5 $ no ouro (preço ~4000 → magnitude 1000 → 1000/200)
f_step() =>
    float s = stepIn
    if s <= 0
        float mag = math.pow(10, math.floor(math.log10(math.max(close, syminfo.mintick * 10))))
        s := mag / 200
    math.max(s, syminfo.mintick * 10)

f_tblPos(string s) =>
    switch s
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.bottom_right

f_tblSize(string s) =>
    switch s
        "Tiny"  => size.tiny
        "Small" => size.small
        "Large" => size.large
        => size.normal

f_fmt(float p) => str.tostring(p, format.mintick)

// ════════════════════════════════════════════════════════════════
// CÁLCULO
// ════════════════════════════════════════════════════════════════
step  = f_step()
half  = step / 10.0                       // meia zona: 0,5 $ no ouro
risk  = half * riskMult                   // 1,5 $ = 150 pontos no ouro

ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
trendUp = not useTrend or ema50 > ema200
trendDn = not useTrend or ema50 < ema200

// nível psicológico logo abaixo / acima do fecho
lvlBelow = math.floor(close / step) * step
lvlAbove = math.ceil(close / step) * step

// visto: a vela fecha para lá da zona de ação do nível que acabou de passar
// a vela atravessa a zona inteira: vinha de fora da zona (lado contrário) e fecha para lá da zona de ação
sigBuy  = trendUp and close > lvlBelow + half and close[1] < lvlBelow - half and lvlBelow > 0
sigSell = trendDn and close < lvlAbove - half and close[1] > lvlAbove + half

// ════════════════════════════════════════════════════════════════
// ESTADO DO SINAL (um de cada vez; o novo apaga o anterior)
// ════════════════════════════════════════════════════════════════
var int   dir      = 0        // +1 compra · −1 venda · 0 sem sinal
var float level    = na       // nível psicológico
var float zAction  = na       // zona de ação (aresta do lado do preço)
var float zTip     = na       // ponta da zona
var float inval    = na
var float exit1    = na
var float exit2    = na
var int   sigBar   = na
var bool  hasPlan  = false
var bool  e1Hit    = false
var bool  closed   = false
var string sigId   = ""

var box   zoneBox  = na
var label checkLbl = na
var label flagLbl  = na
var line  lZone    = na
var line  lInval   = na
var line  lExit1   = na
var line  lExit2   = na
var label tZone    = na
var label tInval   = na
var label tExit1   = na
var label tExit2   = na

// estatísticas
var int nSignals = 0
var int nPlans   = 0
var int nExit1   = 0
var int nExit2   = 0
var int nInval   = 0

f_clear() =>
    box.delete(zoneBox)
    label.delete(checkLbl)
    label.delete(flagLbl)
    line.delete(lZone)
    line.delete(lInval)
    line.delete(lExit1)
    line.delete(lExit2)
    label.delete(tZone)
    label.delete(tInval)
    label.delete(tExit1)
    label.delete(tExit2)

f_level(float p, color c) =>
    ln = line.new(bar_index, p, bar_index + offset, p, color=c, width=1, extend=extend.right)
    lb = label.new(bar_index + offset, p, "", style=label.style_none, textcolor=c, size=size.small)
    [ln, lb]

bool newSignal = false
bool newPlan   = false
bool hitExit1  = false
bool hitExit2  = false
bool hitInval  = false

// 1) acompanhar o plano aberto
if dir != 0 and hasPlan and not closed
    if dir > 0
        if not e1Hit and high >= exit1
            e1Hit := true
            hitExit1 := true
        if high >= exit2
            closed := true
            hitExit2 := true
        else if low <= inval
            closed := true
            hitInval := true
    else
        if not e1Hit and low <= exit1
            e1Hit := true
            hitExit1 := true
        if low <= exit2
            closed := true
            hitExit2 := true
        else if high >= inval
            closed := true
            hitInval := true

// 2) recuo à zona de ação → parâmetros da posição
if dir != 0 and not hasPlan and bar_index > sigBar
    bool touched = dir > 0 ? low <= zAction : high >= zAction
    if touched
        hasPlan := true
        newPlan := true
        nPlans += 1
    else if bar_index > sigBar + offset or (dir > 0 ? high >= exit2 : low <= exit2)
        // a zona esperou «offset» velas sem recuo, ou o preço foi à Saída 2 sem recuar: o sinal expira sem trade
        dir := 0
        f_clear()

// 3) visto novo (apaga o anterior)
if sigBuy or sigSell
    f_clear()
    dir     := sigBuy ? 1 : -1
    level   := sigBuy ? lvlBelow : lvlAbove
    zAction := level + dir * half
    zTip    := level - dir * half
    inval   := zAction - dir * risk
    exit1   := zAction + dir * risk
    exit2   := zAction + dir * risk * 2
    sigBar  := bar_index
    hasPlan := false
    e1Hit   := false
    closed  := false
    newSignal := true
    nSignals += 1
    sigId := str.tostring(time, "yyMMddHHmm") + (dir > 0 ? "B" : "S")

// ════════════════════════════════════════════════════════════════
// DESENHO
// ════════════════════════════════════════════════════════════════
if newSignal
    if showZones
        zoneBox := box.new(bar_index, level + half, bar_index + BOX_W, level - half, border_color=zoneBorder, bgcolor=zoneFill, border_width=1)
    checkLbl := label.new(bar_index, dir > 0 ? high + risk : low - risk, "✔", style=label.style_none, textcolor=C_CHECK, size=size.large)

if newPlan
    [a, b] = f_level(zAction, colZone)
    lZone := a
    tZone := b
    [c, d] = f_level(inval, colInval)
    lInval := c
    tInval := d
    [e, f] = f_level(exit1, colExit1)
    lExit1 := e
    tExit1 := f
    [g, h] = f_level(exit2, colExit2)
    lExit2 := g
    tExit2 := h
    bool pt = lblLang == "PT"
    label.set_text(tZone,  (pt ? "Zona de ação: " : "Zone of action: ") + f_fmt(zAction))
    label.set_text(tInval, (pt ? "Invalidação: " : "Invalidation zone: ") + f_fmt(inval))
    label.set_text(tExit1, (pt ? "Saída 1: " : "Exit 1: ") + f_fmt(exit1))
    label.set_text(tExit2, (pt ? "Saída 2: " : "Exit 2: ") + f_fmt(exit2))

if (hitExit1 or hitInval) and na(flagLbl) and dir != 0
    flagLbl := label.new(bar_index, dir > 0 ? high : low, "", style=label.style_flag, color=C_FLAG, size=size.small, yloc=dir > 0 ? yloc.abovebar : yloc.belowbar)

if hitExit1
    nExit1 += 1
if hitExit2
    nExit2 += 1
if hitInval
    nInval += 1

// níveis psicológicos à volta do preço (redesenhados na última vela)
// (as únicas linhas fixas do gráfico; as EMAs do filtro de tendência não se desenham)
var line[]  psyLines = array.new<line>()
if barstate.islast
    while array.size(psyLines) > 0
        line.delete(array.pop(psyLines))
    if showPsy
        int halfN = math.max(1, psyCount / 2)
        for k = -halfN to halfN
            float p = lvlBelow + k * step
            array.push(psyLines, line.new(bar_index - 500, p, bar_index + offset, p, color=psyCol, width=1, extend=extend.both))

// tabela de estatísticas
var table st = na
if showTable and barstate.islast
    if na(st)
        st := table.new(f_tblPos(tblPos), 2, 6, bgcolor=tblBg, border_width=1, border_color=color.new(tblTxt, 70))
    sz = f_tblSize(tblSize)
    float closedN = nExit1 + nInval
    string wr = closedN > 0 ? str.tostring(100 * nExit1 / closedN, "#.0") + "%" : "–"
    table.cell(st, 0, 0, "Golden Zone by MTM", text_color=tblTxt, text_size=sz, bgcolor=tblBg)
    table.cell(st, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color=tblTxt, text_size=sz, bgcolor=tblBg)
    table.cell(st, 0, 1, "Signals", text_color=tblTxt, text_size=sz)
    table.cell(st, 1, 1, str.tostring(nSignals), text_color=tblTxt, text_size=sz)
    table.cell(st, 0, 2, "Plans",   text_color=tblTxt, text_size=sz)
    table.cell(st, 1, 2, str.tostring(nPlans), text_color=tblTxt, text_size=sz)
    table.cell(st, 0, 3, "Exit 1 / Exit 2", text_color=tblTxt, text_size=sz)
    table.cell(st, 1, 3, str.tostring(nExit1) + " / " + str.tostring(nExit2), text_color=tblTxt, text_size=sz)
    table.cell(st, 0, 4, "Invalidations", text_color=tblTxt, text_size=sz)
    table.cell(st, 1, 4, str.tostring(nInval), text_color=tblTxt, text_size=sz)
    table.cell(st, 0, 5, "Exit 1 rate", text_color=tblTxt, text_size=sz)
    table.cell(st, 1, 5, wr, text_color=tblTxt, text_size=sz)

// ════════════════════════════════════════════════════════════════
// ALERTAS
// ════════════════════════════════════════════════════════════════
f_json(string ev) =>
    '{"strategy":"' + chave + '","event":"' + ev + '","id":"' + sigId + '","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","side":"' + (dir > 0 ? "buy" : "sell") + '","level":' + f_fmt(level) + ',"zone":' + f_fmt(zAction) + ',"invalidation":' + f_fmt(inval) + ',"exit1":' + f_fmt(exit1) + ',"exit2":' + f_fmt(exit2) + ',"price":' + f_fmt(close) + ',"time":"' + str.tostring(time) + '"}'

if newSignal
    alert(f_json("signal"), alert.freq_once_per_bar_close)
if newPlan
    alert(f_json("plan"), alert.freq_once_per_bar_close)
if hitExit1
    alert(f_json("exit1"), alert.freq_once_per_bar_close)
if hitExit2
    alert(f_json("exit2"), alert.freq_once_per_bar_close)
if hitInval
    alert(f_json("invalidation"), alert.freq_once_per_bar_close)

alertcondition(sigBuy,  "Golden Zone Compra", "Golden Zone: visto de compra em {{ticker}} {{interval}}")
alertcondition(sigSell, "Golden Zone Venda",  "Golden Zone: visto de venda em {{ticker}} {{interval}}")
alertcondition(newPlan, "Golden Zone Plano",  "Golden Zone: plano desenhado em {{ticker}} {{interval}}")
