//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// ROCKETNOVA by MTM — médias, estrelas, Rocket Candle, pulso de volatilidade e gestão da trade
//
// PRINCÍPIOS (os mesmos do TrendShot, com código próprio):
//  1. Três EMAs (20 / 50 / 238). O sinal nasce no CRUZAMENTO confirmado da rápida com a lenta.
//  2. Estrelas: máximos e mínimos de swing (Depth / Deviation / Backstep). Por omissão a compra
//     exige uma estrela de mínimo recente e a venda uma estrela de máximo — a "rampa de lançamento".
//  3. Rocket Candle: vela com corpo >= N ATR que fecha no extremo. Pinta-se de amarelo e, se o
//     filtro estiver ligado, é obrigatória nas últimas velas antes do sinal.
//  4. Pulso de volatilidade: ATR(14) contra a sua média de 100 — Alta / Normal / Baixa — num painel.
//  5. Trade Clock: sessão de negociação com o estado do volume (Good / Low Volume). Fora da sessão
//     não há sinais (a não ser que o permitas).
//  6. Gestão: Entry / SL / TP1–TP4 fixos na vela do sinal; depois do TP1 o stop sobe para a
//     entrada (opcional). Um sinal contrário fecha a trade aberta.
//
// ALERTAS / WEBHOOK MTM: Adicionar alerta → condição «Any alert() function call»,
// «Once Per Bar Close», Webhook URL:
//   https://www.morethanmoney.pt/api/webhooks/tradingview?strategy=rocketnova&secret=<secret>
// Cada sinal sai em JSON com os níveis; depois seguem os seguimentos da MESMA trade (mesmo "id"):
// tp1, tp2, tp3, tp4, sl, be (stop na entrada tocado) e exit (fechada por sinal contrário).
// Também há «RocketNova Compra» / «RocketNova Venda» para alertas simples.
// Conteúdo educativo, não constitui consultoria financeira.
// ─────────────────────────────────────────────────────────────────────────────
indicator("RocketNova by MTM", shorttitle="RocketNova by MTM", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=500)

// ════════════════════════════════════════════════════════════════
// INPUTS
// ════════════════════════════════════════════════════════════════
showSLTP = input.bool(true, "Show SL/TP on chart")

gEMA    = "EMA SETTINGS"
fastLen = input.int(20,  "Fast EMA", minval=1, group=gEMA)
slowLen = input.int(50,  "Slow EMA", minval=1, group=gEMA)
longLen = input.int(238, "Long EMA", minval=1, group=gEMA)

gSig      = "SIGNAL SETTINGS"
needStar  = input.bool(true, "Require Launch Star", group=gSig, tooltip="Compra: uma estrela de mínimo nas últimas N velas. Venda: uma estrela de máximo. Desligado = todos os cruzamentos.")
starLook  = input.int(40, "Launch Star Lookback (bars)", minval=1, group=gSig)
needRkt   = input.bool(false, "Require Rocket Candle", group=gSig, tooltip="Exige uma Rocket Candle a favor nas últimas N velas antes do cruzamento.")
rktLook   = input.int(5, "Rocket Candle Lookback (bars)", minval=1, group=gSig)
rktMult   = input.float(1.2, "Rocket Candle Body (x ATR)", minval=0.3, step=0.1, group=gSig, tooltip="Corpo mínimo da Rocket Candle, em múltiplos do ATR(14).")
longFilt  = input.bool(false, "Trade With Long EMA Only", group=gSig, tooltip="Compras só acima da EMA longa, vendas só abaixo.")

gVol      = "VOLATILITY PULSE SETTINGS"
showPulse = input.bool(true, "Show Volatility Pulse", group=gVol, tooltip="ATR(14) contra a sua média de 100 velas: Alta (>= 1,3x), Normal, Baixa (<= 0,7x).")
pulsePos  = input.string("Middle Right", "Pulse Position", options=["Top Right", "Top Middle", "Top Left", "Middle Right", "Middle Left", "Bottom Right", "Bottom Left"], group=gVol)
pulseTxt  = input.color(#1F2A44, "Text Color", group=gVol)

gCol      = "ROCKETNOVA SIGNAL COLORS"
colBear   = input.color(#E8923D, "Bearish Signal", group=gCol)
colBull   = input.color(#5CB85C, "Bullish Signal", group=gCol)
colLbl    = input.color(#FFFFFF, "Label Text", group=gCol)
colRkt    = input.color(#F2E23B, "Rocket Candle", group=gCol)

gStar     = "STAR SETTINGS"
starDepth = input.int(34, "Star Depth", minval=2, group=gStar, tooltip="Velas à esquerda que o extremo tem de dominar para ser estrela.")
starDev   = input.int(13, "Star Deviation", minval=0, group=gStar, tooltip="Afastamento mínimo da estrela anterior do lado contrário, em décimas de ATR (13 = 1,3 ATR).")
starBack  = input.int(8,  "Star Backstep", minval=1, group=gStar, tooltip="Velas à direita que confirmam a estrela (atraso da confirmação).")
colStarBr = input.color(#E05A4F, "Bearish Star", group=gStar)
colStarBl = input.color(#7DD87D, "Bullish Star", group=gStar)

gClock      = "TRADE CLOCK"
showClock   = input.bool(true, "Show Trade Clock", group=gClock)
showOutside = input.bool(false, "Show signals outside of trade times", group=gClock)
sessIn      = input.session("0800-2100", "Trade Session", group=gClock)
clockPos    = input.string("Top Right", "Clock Position", options=["Top Center", "Top Right", "Middle Right", "Bottom Right", "Bottom Center", "Bottom Left", "Middle Left"], group=gClock)
clockSize   = input.string("Normal", "Clock Size", options=["Huge", "Large", "Normal", "Small", "Tiny"], group=gClock)
colGood     = input.color(#5CB85C, "Good Volume", group=gClock)
colLow      = input.color(#E05A4F, "Low Volume", group=gClock)
colClkTxt   = input.color(#FFFFFF, "Text Color", group=gClock)
colClkBrd   = input.color(#1F2A44, "Border Color", group=gClock)

gRisk    = "STOP LOSS / TAKE PROFIT SETTINGS"
slMode   = input.string("Fixed Points", "SL Mode", options=["Fixed Points", "Structure (Last Star)"], group=gRisk, tooltip="Fixed Points: SL a uma distância fixa em pontos.\nStructure (Last Star): SL na última estrela do lado contrário (mínimo na compra, máximo na venda), com uma folga de 0,2 ATR. Sem estrela, cai para Fixed Points. Os TPs mantêm as proporções em relação ao SL.")
slPtsIn  = input.float(0.0, "SL Size (points, 0 = auto)", minval=0.0, step=100.0, group=gRisk, tooltip="1 ponto = 0.01 unidades de preço (índices, metais, cripto) ou o tick mínimo (forex).\n0 = auto: 100 pips em tudo (US30 = 10000 pontos; forex = 1000 pontos em pares de 5 casas) e 200 pips (2000 pontos) no XAUUSD.")
tp1PtsIn = input.float(0.0, "TP1 Size (points, 0 = auto)", minval=0.0, step=100.0, group=gRisk, tooltip="0 = auto: 30% do SL.")
tp2PtsIn = input.float(0.0, "TP2 Size (points, 0 = auto)", minval=0.0, step=100.0, group=gRisk, tooltip="0 = auto: 50% do SL (60% no XAUUSD).")
tp3PtsIn = input.float(0.0, "TP3 Size (points, 0 = auto)", minval=0.0, step=100.0, group=gRisk, tooltip="0 = auto: 100% do SL.")
showTP4  = input.bool(true, "Show TP4", group=gRisk)
tp4PtsIn = input.float(0.0, "TP4 Size (points, 0 = auto)", minval=0.0, step=100.0, group=gRisk, tooltip="0 = auto: 150% do SL.")

gMgmt     = "POSITION MANAGEMENT"
beAfterT1 = input.bool(true, "Stop to entry after TP1", group=gMgmt, tooltip="Depois do TP1 o stop passa para o preço de entrada (break-even).")
closeOpp  = input.bool(true, "Close on opposite signal", group=gMgmt, tooltip="Um sinal contrário fecha a trade aberta (evento exit no webhook).")
followUps = input.bool(true, "Send follow-ups (TP / SL / BE / exit)", group=gMgmt)
chave     = input.string("ROCKETNOVA", "strategy (chave no webhook)", group=gMgmt)

// ════════════════════════════════════════════════════════════════
// INTERNAL PARAMETERS
// ════════════════════════════════════════════════════════════════
const int   PULSE_LEN    = 100         // média do ATR para o pulso de volatilidade
const float PULSE_HIGH   = 1.3
const float PULSE_LOW    = 0.7
const float LOWVOL_MULT  = 0.5         // Low Volume = volume < 0.5 x SMA(20)
const int   BOX_W        = 20          // largura da caixa Entry/SL/TP (velas)
const float STRUCT_GAP   = 0.2         // folga do SL por estrutura (x ATR)

const color C_ENTRY = #D2A63C
const color C_TP    = #12B886
const color C_SL    = #D6401F
const color C_BRAND = #D2A63C

// ════════════════════════════════════════════════════════════════
// HELPERS
// ════════════════════════════════════════════════════════════════
f_pos(string s) =>
    switch s
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Middle"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.bottom_right

f_size(string s) =>
    switch s
        "Tiny"  => size.tiny
        "Small" => size.small
        "Large" => size.large
        "Huge"  => size.huge
        => size.normal

f_fmt(float v) => str.tostring(v, format.mintick)

// ════════════════════════════════════════════════════════════════
// EMAs, ATR, TREND
// ════════════════════════════════════════════════════════════════
emaF = ta.ema(close, fastLen)
emaS = ta.ema(close, slowLen)
emaL = ta.ema(close, longLen)
atr  = ta.atr(14)
trendUp = emaF > emaS

plot(emaF, "Fast EMA", color=colStarBr, linewidth=2)
plot(emaS, "Slow EMA", color=#2962FF, linewidth=2)
plot(emaL, "Long EMA", color=#E8923D, linewidth=3)

// Sentimento (desligado por omissão): colunas até à linha de água das EMAs, a cor da tendência
plot(math.max(emaF, emaS), "Trend Sentiment", style=plot.style_columns, color=trendUp ? color.new(colBull, 88) : color.new(colBear, 88), display=display.none)

// ════════════════════════════════════════════════════════════════
// ROCKET CANDLE
// ════════════════════════════════════════════════════════════════
body   = math.abs(close - open)
rng    = high - low
rktUp  = close > open and body >= rktMult * atr and rng > 0 and (high - close) <= rng * 0.3
rktDn  = close < open and body >= rktMult * atr and rng > 0 and (close - low) <= rng * 0.3
rocket = rktUp or rktDn

// Velas: Cor 0 neutra · Cor 1 tendência de baixa · Cor 2 tendência de alta · Cor 3 Rocket Candle
barcolor(rocket ? colRkt : trendUp ? colBull : colBear, title="Bar Color")

// ════════════════════════════════════════════════════════════════
// STARS (swing highs / lows com Depth, Deviation e Backstep)
// ════════════════════════════════════════════════════════════════
ph = ta.pivothigh(high, starDepth, starBack)
pl = ta.pivotlow(low, starDepth, starBack)
minDev = starDev / 10.0 * atr

var float lastHighStar = na
var float lastLowStar  = na
var int   lastHighBar  = na
var int   lastLowBar   = na

bearStar = not na(ph) and (na(lastLowStar) or ph - lastLowStar >= minDev)
bullStar = not na(pl) and (na(lastHighStar) or lastHighStar - pl >= minDev)

if bearStar
    lastHighStar := ph
    lastHighBar  := bar_index - starBack
if bullStar
    lastLowStar := pl
    lastLowBar  := bar_index - starBack

plotchar(bearStar, "Bearish Star", char="✦", location=location.abovebar, color=colStarBr, size=size.tiny, offset=-starBack)
plotchar(bullStar, "Bullish Star", char="✦", location=location.belowbar, color=colStarBl, size=size.tiny, offset=-starBack)

// ════════════════════════════════════════════════════════════════
// VOLATILITY PULSE + TRADE CLOCK + LOW VOLUME
// ════════════════════════════════════════════════════════════════
atrAvg   = ta.sma(atr, PULSE_LEN)
pulse    = atrAvg > 0 ? atr / atrAvg : 1.0
pulseTxtS = pulse >= PULSE_HIGH ? "HIGH" : pulse <= PULSE_LOW ? "LOW" : "NORMAL"
pulseCol  = pulse >= PULSE_HIGH ? colBear : pulse <= PULSE_LOW ? #9AA0A6 : colBull

inSession = not na(time(timeframe.period, sessIn))
inTrade   = not showClock or showOutside or inSession

volAvg = ta.sma(volume, 20)
lowVol = not na(volume) and volume < volAvg * LOWVOL_MULT

var table pulseTb = table.new(f_pos(pulsePos), 1, 2, bgcolor=na, border_width=1, border_color=colClkBrd)
var table clockTb = table.new(f_pos(clockPos), 1, 1, bgcolor=na, border_width=1, border_color=colClkBrd)
var table brandTb = table.new(position.bottom_right, 1, 1, bgcolor=na)

if barstate.islast
    if showPulse
        table.cell(pulseTb, 0, 0, "Volatility Pulse", text_color=pulseTxt, bgcolor=#E9ECF1, text_size=size.small)
        table.cell(pulseTb, 0, 1, pulseTxtS + " · " + str.tostring(pulse, "#.##") + "x", text_color=color.white, bgcolor=pulseCol, text_size=size.small)
    else
        table.cell(pulseTb, 0, 0, "", bgcolor=na)
        table.cell(pulseTb, 0, 1, "", bgcolor=na)
    if showClock
        string clockTxt = not inSession ? "Market Closed" : lowVol ? "Low Volume" : "Good Volume"
        color  clockCol = not inSession ? #9AA0A6 : lowVol ? colLow : colGood
        table.cell(clockTb, 0, 0, clockTxt, text_color=colClkTxt, bgcolor=clockCol, text_size=f_size(clockSize))
    else
        table.cell(clockTb, 0, 0, "", bgcolor=na)
    table.cell(brandTb, 0, 0, "RocketNova by MTM", text_color=C_BRAND, bgcolor=na, text_size=size.normal)

// Trade Session (desligado por omissão): quadrados no fundo do gráfico durante a sessão
plotshape(inSession, "Trade Session", style=shape.square, location=location.bottom, color=colGood, size=size.tiny, display=display.none)

// ════════════════════════════════════════════════════════════════
// SIGNALS
// ════════════════════════════════════════════════════════════════
crossUp = ta.crossover(emaF, emaS)
crossDn = ta.crossunder(emaF, emaS)

sinceLow  = ta.barssince(bullStar)
sinceHigh = ta.barssince(bearStar)
starOkUp  = not needStar or (not na(sinceLow)  and sinceLow  <= starLook)
starOkDn  = not needStar or (not na(sinceHigh) and sinceHigh <= starLook)

sinceRktUp = ta.barssince(rktUp)
sinceRktDn = ta.barssince(rktDn)
rktOkUp = not needRkt or (not na(sinceRktUp) and sinceRktUp <= rktLook)
rktOkDn = not needRkt or (not na(sinceRktDn) and sinceRktDn <= rktLook)

longOkUp = not longFilt or close > emaL
longOkDn = not longFilt or close < emaL

sigUp = crossUp and inTrade and starOkUp and rktOkUp and longOkUp
sigDn = crossDn and inTrade and starOkDn and rktOkDn and longOkDn

if sigUp
    label.new(bar_index, low,  "Buy",  yloc=yloc.belowbar, style=label.style_label_up,   color=colBull, textcolor=colLbl, size=size.small)
if sigDn
    label.new(bar_index, high, "Sell", yloc=yloc.abovebar, style=label.style_label_down, color=colBear, textcolor=colLbl, size=size.small)

alertcondition(sigUp, "RocketNova Compra", "RocketNova: sinal de COMPRA em {{ticker}} a {{close}}")
alertcondition(sigDn, "RocketNova Venda",  "RocketNova: sinal de VENDA em {{ticker}} a {{close}}")

// ════════════════════════════════════════════════════════════════
// ENTRY / SL / TP + POSITION MANAGEMENT
// ════════════════════════════════════════════════════════════════
isForex   = syminfo.type == "forex"
pointSize = isForex ? syminfo.mintick : 0.01
pipSize   = syminfo.mintick * 10
tkr       = str.upper(syminfo.ticker)
isGold    = str.contains(tkr, "XAU") or str.contains(tkr, "GOLD")

autoSL = isGold ? 2000.0 : (isForex ? 100.0 * pipSize / pointSize : 10000.0)
slPts  = slPtsIn  > 0 ? slPtsIn  : autoSL
tp1Pts = tp1PtsIn > 0 ? tp1PtsIn : slPts * 0.3
tp2Pts = tp2PtsIn > 0 ? tp2PtsIn : slPts * (isGold ? 0.6 : 0.5)
tp3Pts = tp3PtsIn > 0 ? tp3PtsIn : slPts
tp4Pts = tp4PtsIn > 0 ? tp4PtsIn : slPts * 1.5

type Trade
    int dir
    float entry
    float sl
    float slOrig
    float tp1
    float tp2
    float tp3
    float tp4
    int startBar
    bool active
    int hits
    array<box> bxs
    array<line> lns
    array<label> lbs
    int sigTime = 0

var Trade cur = na

f_clear(Trade t) =>
    if not na(t)
        for b in t.bxs
            box.delete(b)
        for l in t.lns
            line.delete(l)
        for lb in t.lbs
            label.delete(lb)
    true

f_level(Trade t, int x1, int x2, float y, string txt, color col) =>
    t.lns.push(line.new(x1, y, x2, y, color=col, width=1))
    t.lbs.push(label.new(x2 + 1, y, txt, style=label.style_label_left, color=col, textcolor=color.white, size=size.small))
    true

// JSON de seguimento: o "id" é a hora da vela de sinal (igual ao da entrada)
f_evt(Trade t, string ev, float px) =>
    if followUps
        string j = '{"strategy":"' + chave + '","event":"' + ev + '","id":"' + str.tostring(t.sigTime) +
         '","ticker":"' + syminfo.ticker + '","exchange":"' + syminfo.prefix + '","action":"' + (t.dir == 1 ? "buy" : "sell") +
         '","price":' + str.tostring(px) + ',"entry":' + str.tostring(t.entry) + ',"sl":' + str.tostring(t.sl) +
         ',"sl_original":' + str.tostring(t.slOrig) + ',"hits":' + str.tostring(t.hits) + ',"timeframe":"' + timeframe.period + '"}'
        alert(j, alert.freq_once_per_bar_close)
    true

f_new(int d) =>
    float e = close
    float fixedRisk = slPts * pointSize
    float structSL = na
    if slMode == "Structure (Last Star)"
        float star = d == 1 ? lastLowStar : lastHighStar
        if not na(star) and (star - e) * d < 0
            structSL := star - d * STRUCT_GAP * atr
    float risk  = na(structSL) ? fixedRisk : math.abs(e - structSL)
    float scale = risk / fixedRisk
    float slP = e - d * risk
    float t1  = e + d * tp1Pts * pointSize * scale
    float t2  = e + d * tp2Pts * pointSize * scale
    float t3  = e + d * tp3Pts * pointSize * scale
    float t4  = e + d * tp4Pts * pointSize * scale
    Trade t = Trade.new(d, e, slP, slP, t1, t2, t3, t4, bar_index, true, 0, array.new<box>(), array.new<line>(), array.new<label>())
    t.sigTime := time
    if showSLTP
        int x1 = bar_index
        int x2 = bar_index + BOX_W
        float tpLast = showTP4 ? t4 : t3
        t.bxs.push(box.new(x1, math.max(e, tpLast), x2, math.min(e, tpLast), border_color=na, bgcolor=color.new(C_TP, 85)))
        t.bxs.push(box.new(x1, math.max(e, slP),    x2, math.min(e, slP),    border_color=na, bgcolor=color.new(C_SL, 85)))
        f_level(t, x1, x2, e,   "Entry: " + f_fmt(e), C_ENTRY)
        f_level(t, x1, x2, t1,  "TP1: " + f_fmt(t1), C_TP)
        f_level(t, x1, x2, t2,  "TP2: " + f_fmt(t2), C_TP)
        f_level(t, x1, x2, t3,  "TP3: " + f_fmt(t3), C_TP)
        if showTP4
            f_level(t, x1, x2, t4, "TP4: " + f_fmt(t4), C_TP)
        f_level(t, x1, x2, slP, "SL: " + f_fmt(slP), C_SL)
    t

f_json(int d, Trade t) =>
    string act = d == 1 ? "buy" : "sell"
    int sinceStar = d == 1 ? sinceLow : sinceHigh
    '{"strategy":"' + chave + '","event":"entry","id":"' + str.tostring(t.sigTime) + '","source":"rocketnova","ticker":"' + syminfo.ticker +
     '","exchange":"' + syminfo.prefix + '","action":"' + act + '","side":"' + act + '","timeframe":"' + timeframe.period +
     '","entry":' + str.tostring(t.entry) + ',"sl":' + str.tostring(t.sl) +
     ',"tp1":' + str.tostring(t.tp1) + ',"tp2":' + str.tostring(t.tp2) + ',"tp3":' + str.tostring(t.tp3) + ',"tp4":' + str.tostring(t.tp4) +
     ',"star_bars":' + (na(sinceStar) ? "null" : str.tostring(sinceStar)) + ',"rocket":' + (rocket ? "true" : "false") +
     ',"volatility":"' + str.lower(pulseTxtS) + '","volume":"' + (lowVol ? "low" : "good") + '","tf":"' + timeframe.period + '"}'

// seguimento da trade aberta (na vela seguinte à entrada em diante)
if not na(cur) and cur.active and bar_index > cur.startBar
    bool slHit = cur.dir == 1 ? low <= cur.sl : high >= cur.sl
    if slHit
        bool protegido = cur.hits > 0 and beAfterT1
        cur.active := false
        f_evt(cur, protegido ? "be" : "sl", cur.sl)
    else
        array<float> tps = array.from(cur.tp1, cur.tp2, cur.tp3, cur.tp4)
        int maxK = showTP4 ? 3 : 2
        if cur.hits <= maxK
            for k = cur.hits to maxK
                float tp = tps.get(k)
                bool hit = cur.dir == 1 ? high >= tp : low <= tp
                if hit
                    cur.hits := k + 1
                    f_evt(cur, "tp" + str.tostring(k + 1), tp)
                    if k == 0 and beAfterT1
                        cur.sl := cur.entry
        if cur.hits > maxK
            cur.active := false

// novo sinal: fecha a trade contrária que ainda esteja aberta e abre a nova
if (sigUp or sigDn) and barstate.isconfirmed
    int d = sigUp ? 1 : -1
    if not na(cur) and cur.active and closeOpp and cur.dir != d
        f_evt(cur, "exit", close)
    if not na(cur)
        cur.active := false
    f_clear(cur)
    cur := f_new(d)
    alert(f_json(d, cur), alert.freq_once_per_bar_close)

