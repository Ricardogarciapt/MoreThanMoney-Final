{
  "installCommand": "npm install --legacy-peer-deps",
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/notifications/check-alerts",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/nightly-tp-sl",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/email-marketing/sequences/process",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/member-subscriptions",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/check-trials",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/subscription-expiry",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/daily-dca-check",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/daily-dca-post",
      "schedule": "0 9 * * *"
    }
  ]
}
