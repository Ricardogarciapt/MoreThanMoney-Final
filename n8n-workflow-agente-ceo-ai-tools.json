        "specifyOutputs": true,
        "outputsSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"leads\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\"type\": \"string\"},\n          \"platform\": {\"type\": \"string\"},\n          \"message\": {\"type\": \"string\"},\n          \"profile_url\": {\"type\": \"string\"},\n          \"engagement_score\": {\"type\": \"number\"}\n        }\n      }\n    },\n    \"total_encontrados\": {\"type\": \"number\"}\n  }\n}"
