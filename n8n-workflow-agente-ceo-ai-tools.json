      "id": "telegram-trigger",
      "name": "📱 Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [240, 1000],
      "webhookId": "telegram-mtm-bot",
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot",
          "name": "Telegram Bot MTM"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const message = $input.first().json.message;\nconst chatId = message.chat.id;\nconst text = message.text || '';\n\nreturn [{\n  json: {\n    action: 'comando_telegram',\n    chat_id: chatId,\n    comando: text,\n    user_name: message.from?.first_name || 'Ricardo',\n    systemMessage: `COMANDO TELEGRAM RECEBIDO: ${text}\n\nUsuário: ${message.from?.first_name}\nChat ID: ${chatId}\n\nInterprete o comando e execute a ação correspondente usando as ferramentas disponíveis:\n\n/status → Usar analytics_supabase + enviar_telegram\n/leads → Buscar novos leads + enviar_telegram\n/meetings → Buscar reuniões agendadas + enviar_telegram\n/analytics → analytics_supabase completo + enviar_telegram\n/campaign <segmento> → segmentar_emails + enviar_telegram\n/post <ideia> → gerar_conteudo + enviar_telegram\n/pause → Pausar prospeção + enviar_telegram\n/resume → Retomar prospeção + enviar_telegram\n\nSempre responda ao Ricardo via Telegram com resultado da ação.`\n  }\n}];"
      },
      "id": "process-telegram",
      "name": "⚙️ Processar Telegram",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [460, 1000]
    },
    {
      "parameters": {
        "functionCode": "// Implementação REAL das Tools\nconst toolName = $input.first().json.tool;\nconst params = $input.first().json.params || {};\n\nswitch(toolName) {\n  case 'prospectar_redes_sociais':\n    // Mock de prospeção (substituir com APIs reais)\n    const mockLeads = [\n      {\n        name: 'joao_investidor',\n        platform: 'instagram',\n        message: 'Procurando rendimento extra online',\n        profile_url: 'https://instagram.com/joao_investidor',\n        engagement_score: 18\n      },\n      {\n        name: 'maria_trader',\n        platform: 'tiktok',\n        message: 'Quero aprender trading de cripto',\n        profile_url: 'https://tiktok.com/@maria_trader',\n        engagement_score: 53\n      }\n    ];\n    return [{ json: { leads: mockLeads, total_encontrados: mockLeads.length } }];\n    \n  case 'gerar_mensagem_ia':\n    // Será processado pelo GPT-4o do agente\n    const estagios = {\n      conexao: `Olá ${params.lead_name}! 👋 Vi que tens interesse em ${params.mensagem_original}. Já pensaste em como a educação financeira pode transformar isso em resultados concretos?`,\n      curiosidade: `Hey ${params.lead_name}! Há 3 anos estava onde tu estás agora. Descobri que combinar educação sólida (aprendi com IQONIC) + tecnologia avançada duplica resultados. Já pensaste em rentabilizar online de forma inteligente?`,\n      apresentacao: `${params.lead_name}, partilho contigo o que criámos: morethanmoney.pt 🚀\\n\\nVê os vídeos de consciencialização quando tiveres tempo. Depois falamos se fizer sentido para ti!`,\n      reuniao: `${params.lead_name}, viste os vídeos? Se sim e fizer sentido, que tal marcarmos uma conversa rápida para entender melhor os teus objetivos? 📅 calendly.com/morethanmoneypt`\n    };\n    return [{ json: { mensagem: estagios[params.estagio], proximo_estagio: params.estagio === 'conexao' ? 'curiosidade' : 'apresentacao', tempo_followup: '2h' } }];\n    \n  case 'analytics_supabase':\n    // Mock analytics (substituir com query real)\n    return [{\n      json: {\n        estatisticas: {\n          novos: 45,\n          contactados: 23,\n          interessados: 12,\n          agendados: 5,\n          convertidos: 2\n        },\n        total_leads: 87,\n        taxa_conversao: 2.3\n      }\n    }];\n    \n  case 'gerar_conteudo':\n    const ideias = [\n      {\n        titulo: '3 Erros que Impedem Liberdade Financeira',\n        pilar: 'educacao',\n        formato: 'reel',\n        plataforma: 'instagram',\n        horario: '18h',\n        cta: 'Aprende mais em morethanmoney.pt'\n      },\n      {\n        titulo: 'Como Transformei Vida em 3 Anos (História Real)',\n        pilar: 'transformacao',\n        formato: 'story',\n        plataforma: 'instagram',\n        horario: '21h',\n        cta: 'Pergunta-me como'\n      }\n    ];\n    return [{ json: { ideias, total_geradas: ideias.length } }];\n    \n  default:\n    return [{ json: { success: true, message: `Tool ${toolName} executado` } }];\n}"
      },
