    {
      "parameters": {
        "functionCode": "const event = $input.first().json;\nconst payload = event.payload || event;\n\nreturn [{\n  json: {\n    action: 'reuniao_agendada',\n    lead_email: payload.email || payload.invitee?.email,\n    lead_name: payload.name || payload.invitee?.name || 'Lead',\n    event_type: payload.event_type?.name || 'Onboarding',\n    start_time: payload.scheduled_event?.start_time || new Date().toISOString(),\n    meeting_link: payload.scheduled_event?.location?.join_url || 'https://calendly.com/morethanmoneypt',\n    systemMessage: `AÇÃO URGENTE: Nova reunião agendada via Calendly.\n\nLead: ${payload.name || payload.invitee?.name}\nEmail: ${payload.email || payload.invitee?.email}\nData: ${payload.scheduled_event?.start_time}\n\nExecute as seguintes ações:\n1. Atualizar lead no Supabase (status=scheduled, stage=meeting)\n2. Enviar email de notificação para Ricardo\n3. Enviar mensagem Telegram para Ricardo\n4. Preparar sequência de onboarding (se lead converter)`\n  }\n}];"
      },
      "id": "process-calendly",
      "name": "⚙️ Processar Calendly",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [460, 800]
    },
